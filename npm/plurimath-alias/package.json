{
  "name": "plurimath",
  "version": "0.0.0-ALIAS",
  "description": "The unscoped alias for @plurimath/plurimath — the native TypeScript implementation of Plurimath. Parse and render AsciiMath, LaTeX, UnicodeMath, MathML, OMML and HTML.",
  "license": "MIT",
  "main": "index.cjs",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@plurimath/plurimath": "0.0.0-ALIAS"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plurimath/plurimath-ts.git"
  },
  "homepage": "https://github.com/plurimath/plurimath-ts",
  "bugs": "https://github.com/plurimath/plurimath-ts/issues",
  "keywords": [
    "plurimath",
    "asciimath",
    "mathml",
    "latex",
    "omml",
    "unicodemath",
    "math"
  ],
  "files": [
    "index.cjs",
    "index.mjs",
    "index.d.ts",
    "README.md"
  ]
}
