{
  "name": "@plurimath/plurimath-ts",
  "version": "0.0.0",
  "private": true,
  "description": "Native TypeScript implementation of Plurimath",
  "license": "BSD-2-Clause",
  "author": "Ribose Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/plurimath/plurimath-ts"
  },
  "homepage": "https://github.com/plurimath/plurimath-ts#readme",
  "keywords": [
    "plurimath",
    "math",
    "mathml",
    "asciimath",
    "latexmath",
    "unicodemath",
    "omml",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.5",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./asciimath": {
      "import": {
        "types": "./dist/asciimath.d.ts",
        "default": "./dist/asciimath.js"
      },
      "require": {
        "types": "./dist/asciimath.d.cts",
        "default": "./dist/asciimath.cjs"
      }
    },
    "./latex": {
      "import": {
        "types": "./dist/latex.d.ts",
        "default": "./dist/latex.js"
      },
      "require": {
        "types": "./dist/latex.d.cts",
        "default": "./dist/latex.cjs"
      }
    },
    "./mathml": {
      "import": {
        "types": "./dist/mathml.d.ts",
        "default": "./dist/mathml.js"
      },
      "require": {
        "types": "./dist/mathml.d.cts",
        "default": "./dist/mathml.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "node scripts/check.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "boundaries": "node scripts/gate-boundaries.mjs",
    "gate:package": "node scripts/gate-package.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.3.0",
    "@types/node": "^24.0.0",
    "dependency-cruiser": "^17.0.0",
    "esbuild": "^0.28.0",
    "publint": "^0.3.0",
    "tsdown": "0.22.14",
    "typescript": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
